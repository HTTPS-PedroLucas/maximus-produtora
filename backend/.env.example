# Porta da API (o backend da barbearia neste mesmo repositório usa a 4000)
PORT=4100

# Chave usada para assinar os tokens de sessão. TROQUE em produção.
JWT_SECRET=troque-esta-chave-em-producao
TOKEN_TTL=12h

# Fuso horário usado para "hoje" e para a semana da agenda
TIMEZONE=America/Fortaleza

# Workspace criado automaticamente na primeira execução
WORKSPACE_NAME=Máximus Produtora
WORKSPACE_SLUG=maximus-produtora
HOME_CITY=Senador Pompeu
HOME_REGION=Sertão Central

# Primeiro administrador (criado apenas se ainda não existir nenhum)
ADMIN_NAME=Administração Máximus
ADMIN_EMAIL=admin@maximusprodutora.com.br
ADMIN_PASSWORD=maximus123

# Acesso de equipe criado pelo "npm run seed"
MEMBER_EMAIL=equipe@maximusprodutora.com.br
MEMBER_PASSWORD=equipe123

# Uploads (bucket local de imagens)
UPLOADS_DIR=
MAX_UPLOAD_MB=8

# Origem permitida no CORS (separe por vírgula). Vazio = liberado para o dev local.
CORS_ORIGIN=

# Defina como 1 para o backend servir também o build do frontend (deploy único)
SERVE_FRONTEND=0
