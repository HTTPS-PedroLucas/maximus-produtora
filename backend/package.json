{
  "name": "maximus-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API do sistema de planejamento de captações da Máximus Produtora",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
